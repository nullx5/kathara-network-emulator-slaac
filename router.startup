# router.startup
# Habilitar IPv6 en la interfaz
sysctl -w net.ipv6.conf.eth0.disable_ipv6=0

# Configurar IPs
ip -6 addr add 2001:db8:1::1/64 dev eth0
ip -6 addr add fe80::1/64 scope link dev eth0
ip link set eth0 up

# Instalación de radvd (Kathará usa debian/ubuntu por defecto)
apt-get update
apt-get install -y radvd

# Crear configuración de radvd
cat <<EOF > /etc/radvd.conf
interface eth0 {
    AdvSendAdvert on;
    MinRtrAdvInterval 3;
    MaxRtrAdvInterval 10;
    prefix 2001:db8:1::/64 {
        AdvOnLink on;
        AdvAutonomous on;
        AdvRouterAddr on;
    };
};
EOF
